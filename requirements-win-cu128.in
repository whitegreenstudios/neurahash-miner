# Regenerate the lock with:
#   uv pip compile requirements-win-cu128.in --generate-hashes --python-version 3.13 --python-platform x86_64-pc-windows-msvc --index-strategy unsafe-best-match --extra-index-url https://download.pytorch.org/whl/cu128 -o requirements-win-cu128.lock
# Every transitive wheel is held at a release from before 2026-10-27 (two weeks before lock time).
# Install with: uv pip sync --require-hashes requirements-win-cu128.lock
